# ============================================================
# DxCloud 环境变量模板 —— 复制为 .env 后按需修改（.env 已被 .gitignore 排除，禁止提交）
# 所有变量在 compose 中均有开发默认值，未创建 .env 也可直接 docker compose up -d
# ============================================================

# ---------- MySQL（compose 内部使用；宿主映射端口见 *_EXPOSE_PORT） ----------
MYSQL_DATABASE=dxcloud
MYSQL_USER=dxcloud
MYSQL_PASSWORD=dxcloud_dev_pass
MYSQL_ROOT_PASSWORD=dxcloud_root_dev
MYSQL_EXPOSE_PORT=13306          # 避开本机 MySQL 3306
MYSQL_IMAGE=mysql:8.0           # 中国大陆一键脚本可替换为镜像加速源前缀

# ---------- Redis（生产务必改密） ----------
REDIS_PASSWORD=dxcloud_redis_dev
REDIS_EXPOSE_PORT=16379          # 避开本机 Redis 6379
REDIS_IMAGE=redis:7-alpine

# ---------- 私有 Registry ----------
REGISTRY_URL=registry:5000
REGISTRY_ENGINE_URL=host.docker.internal:15000   # daemon 视角（Linux 生产可用 127.0.0.1:15000）
REGISTRY_EXPOSE_PORT=15000
REGISTRY_IMAGE=registry:2.8

# ---------- JWT（生产必须替换为 64 位随机串） ----------
JWT_SECRET=dev-only-secret-change-me-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ---------- Docker Engine（生产 Linux: unix:///var/run/docker.sock；
#           Windows Docker Desktop 本机直跑: npipe:////./pipe/docker_engine） ----------
DOCKER_HOST=unix:///var/run/docker.sock

# ---------- 后端 ----------
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=debug

# ---------- 前端 ----------
NUXT_API_PROXY_TARGET=http://cloud-api:8080
TRAEFIK_IMAGE=traefik:v3

# ---------- Traefik ----------
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443           # 生产 HTTPS（证书见 deploy/certs，tools/gencert.go 生成）
TRAEFIK_DASHBOARD_PORT=8080

# ---------- 安全（Phase 11/12） ----------
# 自定义 seccomp profile 名（需已加载进 docker daemon；空 = 守护进程默认 profile）
SECCOMP_PROFILE=
# 生产 backend 访问 docker.sock 的宿主组 GID（Docker Desktop=0；Linux 生产=宿主 docker 组 GID）
DOCKER_GROUP_GID=0

# ---------- 构建加速（国内镜像源） ----------
GOPROXY=https://goproxy.cn,direct
NPM_REGISTRY=https://registry.npmmirror.com
GO_BUILD_IMAGE=golang:1.25-alpine
ALPINE_RUNTIME_IMAGE=alpine:3.20
NODE_IMAGE=node:20-alpine
